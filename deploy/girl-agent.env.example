# ==============================================================================
# girl-agent environment configuration example
# Copy this file to /etc/girl-agent.env (or .env) and set your values.
# ==============================================================================

# WebUI access password (admin panel)
GIRL_AGENT_WEBUI_PASSWORD=your_webui_password_here

# Audio & Speech API keys (Optional)
GROQ_API_KEY=your_groq_api_key_here
FISH_API_KEY=your_fish_audio_api_key_here
